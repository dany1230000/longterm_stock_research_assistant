# 00631L live proxy environment template.
# Copy to backend/.env for local development, or set these variables in the
# deployment environment. Do not commit backend/.env.

# Public deployment metadata. PUBLIC_API_BASE_URL is the URL users and the
# frontend should use to reach this backend. ALLOWED_ORIGINS is a comma-separated
# list of frontend origins allowed by CORS. Use origins only, not path routes.
# GitHub Pages example: https://dany1230000.github.io
PUBLIC_API_BASE_URL=https://your-backend.example.com
ALLOWED_ORIGINS=https://dany1230000.github.io,https://your-frontend.example.com

TWSE_00631L_INTRADAY_NAV_URL=https://mis.twse.com.tw/stock/data/all_etf.txt

# Official TWSE monthly price history API. {yyyymmdd} is replaced by the first
# day of each requested month by scripts\00631l_update_price_history.cmd.
TWSE_00631L_PRICE_HISTORY_URL_TEMPLATE=https://www.twse.com.tw/exchangeReport/STOCK_DAY?response=json&date={yyyymmdd}&stockNo=00631L

# Verified Yuanta INAV API shape used by:
# https://www.yuantaetfs.com/tradeInfo/INav/Asia_ETF
# DeviceId is a UUID-like client identifier, not a secret. If Yuanta changes
# its Nuxt API contract, refresh this URL from the page network requests.
YUANTA_00631L_INTRADAY_NAV_URL=https://etfapi.yuantaetfs.com/ectranslation/api/trans?APIType=ETFBackstage&CompanyName=YUANTAFUNDS&PageName=%2FtradeInfo%2FINav%2FAsia_ETF&DeviceId=00000000-0000-4000-8000-000000000631&FuncId=ETFNAV%2FGetINAV_Data&AppName=ETF&Device=4&Platform=ETF

# twse: TWSE only. yuanta: Yuanta only. auto: TWSE first, then Yuanta fallback.
00631L_INTRADAY_NAV_SOURCE=auto

00631L_PROFILE_CACHE_SECONDS=86400
00631L_HOLDINGS_CACHE_SECONDS=600
00631L_INTRADAY_NAV_CACHE_SECONDS=15
00631L_PROXY_TIMEOUT_SECONDS=8

# Public deployments should mount this directory as persistent storage and set
# 00631L_DATA_PERSISTENCE_MODE=persistent. Docker/VPS examples mount /data/00631l.
# For local development, backend/data with local mode is OK.
00631L_DATA_DIR=/data/00631l
00631L_DATA_PERSISTENCE_MODE=persistent

# Local JSONL history store for daily Yuanta ratio snapshots.
# This is local app data and should not be committed.
00631L_HOLDINGS_HISTORY_PATH=/data/00631l/00631l_holdings_history.jsonl

# Local JSONL history store for official intraday NAV samples.
00631L_INTRADAY_NAV_HISTORY_PATH=/data/00631l/00631l_intraday_nav_history.jsonl

# Local JSONL cache for official TWSE price history. This is local app data and
# should not be committed.
00631L_PRICE_HISTORY_PATH=/data/00631l/00631l_price_history.jsonl

# Local CSV export directory. This is local operational output and should not
# be committed.
00631L_HISTORY_EXPORT_DIR=/data/00631l/exports

# Local daily cycle status file. The v1.15 daily cycle records its latest run
# here so operations/status can display it.
00631L_DAILY_CYCLE_STATUS_PATH=/data/00631l/00631l_daily_cycle_status.json

# Local data integrity check result. This is local operational state.
00631L_INTEGRITY_STATUS_PATH=/data/00631l/00631l_integrity_status.json

# Latest restore dry-run result. The dry-run only reads backup archives and does
# not overwrite local app data.
00631L_RESTORE_DRY_RUN_STATUS_PATH=/data/00631l/00631l_restore_dry_run_status.json

# Local backup output directory. Backup archives are local operational files and
# should not be committed.
00631L_BACKUP_DIR=/data/00631l/backups
00631L_BACKUP_RETENTION_COUNT=30

# Local daily Markdown report output directory. Reports are local operational
# files and should not be committed.
00631L_REPORT_DIR=/data/00631l/reports
00631L_REPORT_RETENTION_COUNT=30

# CSV exports use fixed current filenames; this value is kept for policy
# reporting and future export archives.
00631L_EXPORT_RETENTION_COUNT=30

# AI analysis is rule-based by default and does not need any API key.
# External LLM integration is a disabled placeholder for future releases only.
00631L_ANALYSIS_PROVIDER=rule_based
00631L_EXTERNAL_LLM_ENABLED=false
